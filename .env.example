# ==============================================================================
# HealthDastaan Admin Portal - Environment Variables Template
# ==============================================================================
# IMPORTANT:
# - NEXT_PUBLIC_* variables are inlined into the client-side JavaScript bundle
#   at BUILD TIME. Never store private tokens or secrets in NEXT_PUBLIC_* vars.
# - Copy this file to .env.local for local overrides (never commit .env.local).
# ==============================================================================

# Browser-facing backend API endpoint (used by client browser requests)
NEXT_PUBLIC_API_BASE_URL=https://api.healthdastaan.com/v1

# Legacy/fallback alias for API base URL
NEXT_PUBLIC_API_URL=https://api.healthdastaan.com/v1

# Server-side backend API URL (used by container-to-container or SSR requests)
# In Docker Compose, this resolves to the NestJS service hostname (e.g., http://backend:3000/v1)
INTERNAL_API_BASE_URL=http://backend:3000/v1

# Application port (container default: 3000, mapped to 3001 on host)
PORT=3000

# Node runtime environment
NODE_ENV=production
